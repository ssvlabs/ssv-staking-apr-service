# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=ssv_user
DATABASE_PASSWORD=ssv_password
DATABASE_NAME=ssv_apr

# Blockchain
RPC_URL=https://mainnet.infura.io/v3/replace-me
CHAIN_ID=1
# Public SSVNetwork proxy address. Snapshot logic reads reward events from here.
STAKING_CONTRACT_ADDRESS=0xDD9BC35aE942eF0cFa76930954a156B3fF30a4E1
VIEWS_CONTRACT_ADDRESS=0xafE830B6Ee262ba11cce5F32fDCd760FFE6a66e4

# cSSV Daily Snapshot
CSSV_SNAPSHOT_ENABLED=false
# Must be an archive-capable mainnet RPC when snapshots are enabled.
ARCHIVE_RPC_URL=https://mainnet.infura.io/v3/replace-me
CSSV_TOKEN_ADDRESS=0xe018D31F120A637828F46aFD6c64EC099d960546
CSSV_SNAPSHOT_START_BLOCK=24920727
LOG_CHUNK_SIZE_BLOCKS=2400

# LST/LRT Holder Snapshot (Syndicate Boost campaign)
# Set to true to enable the one-time Jun 5 2PM UTC holder snapshot and eligibility API.
# Requires ARCHIVE_RPC_URL and CHAIN_ID (shared with cSSV snapshot).
LST_SNAPSHOT_ENABLED=false

# CoinGecko
COINGECKO_API_URL=https://api.coingecko.com/api/v3

# Explorer Center
EXPLORER_CENTER_URL=https://explorer-center.example.com/api/v4/mainnet

# Oracle
ORACLE_URL=https://oracle.example.com

# Cron Schedule (every 3 hours)
APR_CALCULATION_CRON='0 */3 * * *'

# App
PORT=3000
NODE_ENV=development
